# Define Horn of Africa countries
hoa_countries <- c(
  "Sudan"
  ,
  "South Sudan"
  ,
  "Eritrea"
  ,
  "Djibouti"
  ,
  "Ethiopia"
  ,
  "Somalia"
  ,
  "Kenya"
)

# Filter GED to Horn of Africa
hoa_ged <- ged_raw |>
  dplyr::filter(
    country %in% hoa_countries,
    year >= 2000,
    year <= 2025
  )
# Check number of events by country
table(hoa_ged$country)

# Check year range
range(hoa_ged$year, na.rm = TRUE)

# Check missing coordinates
sum(is.na(hoa_ged$latitude))
sum(is.na(hoa_ged$longitude))

